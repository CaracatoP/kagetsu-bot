# Bot / API — nunca adicionar estas variáveis ao frontend público.
DISCORD_TOKEN=
DATABASE_URL=
DATABASE_SSL=auto
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Aleatório, mínimo 32 caracteres; manter estável entre réplicas da API.
SESSION_SECRET=
WEB_URL=http://localhost:3000
API_PORT=3001
# Em Railway, PORT é fornecida pela plataforma; deixe API_PORT vazio lá.
LOG_LEVEL=info
# Configure somente para o número real de proxies confiáveis.
TRUST_PROXY_HOPS=0
# Opcional: testes usam schema isolado nesta conexão; fallback DATABASE_URL.
TEST_DATABASE_URL=
